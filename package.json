{
  "name": "raft-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A TypeScript agent built with Claude Agent SDK",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json && vite build ui --outDir ../dist-ui --emptyOutDir",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "desktop": "npm run build && node dist/launch.js",
    "web": "npm run build && node dist/cli.js serve",
    "ctl": "node dist/cli.js ctl",
    "smoke:live": "tsx tests/live-smoke.ts",
    "smoke:subagents": "tsx tests/subagents-live-smoke.ts",
    "smoke:skills-sdk": "tsx tests/skills-sdk-smoke.ts",
    "smoke:skills-react": "tsx tests/skills-react-smoke.ts",
    "smoke:skills-live": "tsx tests/skills-live-smoke.ts",
    "smoke:ui": "tsx tests/ui-smoke.ts",
    "smoke:desktop": "tsx tests/desktop-smoke.ts",
    "smoke:search-sdk": "tsx tests/search-sdk-live-smoke.ts",
    "smoke:inspection": "tsx tests/inspection-ui-smoke.ts",
    "smoke:tavily": "tsx tests/tavily-live-smoke.ts",
    "smoke:context-sdk": "tsx tests/context-sdk-smoke.ts",
    "smoke:context-ui": "tsx tests/context-ui-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.267",
    "dotenv": "17.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.3.0",
    "playwright": "^1.63.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "^8.3.0"
  }
}
